{
  "expo": {
    "name": "Midnight",
    "slug": "midnight",
    "description": "Midnight is a daily discipline tracker that turns consistent effort into measurable progress.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/midnight-icon-concept-v2.png",
    "scheme": "midnight",
    "userInterfaceStyle": "automatic",
    "notification": {
      "icon": "./assets/images/android-icon-monochrome-v2.png",
      "color": "#F5B84B",
      "androidMode": "default"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#02070D",
        "foregroundImage": "./assets/images/android-icon-foreground-v2.png",
        "monochromeImage": "./assets/images/android-icon-monochrome-v2.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.jacobross.midnight",
      "versionCode": 1,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/midnight-icon-concept-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#F5B84B",
          "defaultChannel": "midnight-reminders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/midnight-icon-concept-v2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#02070D",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
